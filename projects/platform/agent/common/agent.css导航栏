/* ==========================================================
   泰卦智能 · 智能体框架页面 — 公共样式
   与主站 html/common.css 保持同一套设计语言
   黑白灰 + 品牌红 #c0392b
   ========================================================== */
:root{
  --bg:#ffffff;
  --bg-soft:#fafafa;
  --panel:#f4f4f5;
  --border:#e4e4e7;
  --border-strong:#d4d4d8;
  --text:#18181b;
  --text-2:#3f3f46;
  --muted:#71717a;
  --muted-2:#a1a1aa;
  --accent:#c0392b;
  --accent-soft:rgba(192,57,43,.08);
  --ok:#16a34a;
  --mono:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono",monospace;
  --shadow:0 12px 30px rgba(24,24,27,.07);
  --side-w:246px;
}
html[data-theme="dark"]{
  --bg:#111113;
  --bg-soft:#18181b;
  --panel:#1f1f23;
  --border:#2c2c30;
  --border-strong:#3f3f46;
  --text:#f4f4f5;
  --text-2:#d4d4d8;
  --muted:#a1a1aa;
  --muted-2:#71717a;
  --accent:#e05a4b;
  --accent-soft:rgba(224,90,75,.12);
  --ok:#4ade80;
  --shadow:0 12px 30px rgba(0,0,0,.45);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  background:var(--bg);color:var(--text);
  font-family:"Noto Sans SC",system-ui,-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;
  -webkit-font-smoothing:antialiased;line-height:1.6;
}
a{color:inherit;text-decoration:none}
img{max-width:100%}
button{font-family:inherit}
::selection{background:var(--text);color:var(--bg)}
::-webkit-scrollbar{width:9px;height:9px}
::-webkit-scrollbar-thumb{background:var(--border-strong);border-radius:99px}
::-webkit-scrollbar-track{background:transparent}

/* ---------- 布局 ---------- */
.console{display:flex;min-height:100vh}
.sidebar{
  width:var(--side-w);flex:0 0 var(--side-w);position:fixed;inset:0 auto 0 0;z-index:50;
  background:var(--bg);border-right:1px solid var(--border);
  display:flex;flex-direction:column;transition:background .3s,border-color .3s;
}
.side-brand{
  display:flex;align-items:center;gap:10px;padding:18px 18px;
  border-bottom:1px solid var(--border);
}
.side-brand img{height:34px;display:block;border-radius:4px}
.side-brand .bt{font-size:11px;font-family:var(--mono);color:var(--muted-2);letter-spacing:.1em;line-height:1.35;min-width:0}
.side-brand .bt b{display:block;color:var(--text);font-size:12.5px;font-family:inherit;letter-spacing:0;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

/* ---------- 区域版本条（侧栏，一眼分国内/海外） ---------- */
.env-band{
  display:flex;align-items:center;gap:7px;margin:12px 14px 0;padding:7px 11px;
  border-radius:9px;font-size:12.5px;font-weight:600;letter-spacing:.02em;
  border:1px solid transparent;
}
.env-band i{width:7px;height:7px;border-radius:50%;flex:0 0 7px;background:currentColor;box-shadow:0 0 0 3px rgba(0,0,0,.04)}
.env-band span{font-weight:400;font-size:11px;font-family:var(--mono);opacity:.72;margin-left:auto;letter-spacing:.06em}
.env-band.dom{color:#c0392b;background:rgba(192,57,43,.08);border-color:rgba(192,57,43,.22)}
.env-band.glb{color:#2563eb;background:rgba(37,99,235,.08);border-color:rgba(37,99,235,.22)}
.env-band.base{color:#7c3aed;background:rgba(124,58,237,.08);border-color:rgba(124,58,237,.22)}
html[data-theme="dark"] .env-band.dom{color:#f08a7e;background:rgba(192,57,43,.16);border-color:rgba(240,138,126,.28)}
html[data-theme="dark"] .env-band.glb{color:#8ab4ff;background:rgba(59,130,246,.16);border-color:rgba(138,180,255,.28)}
html[data-theme="dark"] .env-band.base{color:#c4a6ff;background:rgba(124,58,237,.16);border-color:rgba(196,166,255,.28)}

/* ---------- 页面顶部区域色带：国内红 / 海外蓝 / 独立站紫 ---------- */
body::before{
  content:"";position:fixed;top:0;left:0;right:0;height:3px;z-index:70;
  background:#c0392b;pointer-events:none;
}
body.env-glb::before{background:#2563eb}
body.env-base::before{background:#7c3aed}
.side-scroll{flex:1;overflow-y:auto;padding:12px 10px 16px}
.side-group{margin-bottom:14px}
.side-group.flat{padding-bottom:2px}
.side-group.flat>.side-sub{font-weight:500}
.side-group>.g-head{
  display:flex;align-items:center;gap:8px;padding:7px 10px 6px;
  font-size:12.5px;color:var(--text);letter-spacing:.02em;font-weight:500;
}
/* g-line 横线已按要求全部移除 */
.side-group>.g-head .g-line{display:none}
.side-sub{
  display:flex;align-items:center;gap:9px;
  padding:8px 12px;border-radius:9px;font-size:13.5px;color:var(--text-2);
  cursor:pointer;transition:all .18s;border:1px solid transparent;position:relative;
}
.side-sub::before{
  content:"";width:5px;height:5px;border-radius:50%;background:var(--border-strong);
  flex:0 0 5px;transition:background .18s;
}
.side-sub:hover{background:var(--bg-soft);color:var(--text)}
.side-sub.active{background:var(--panel);color:var(--text);font-weight:600;border-color:var(--border)}
.side-sub.active::before{background:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
.side-sub.cur{color:var(--accent);font-weight:600}
.side-sub.cur::before{background:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
.sw-group{margin-top:14px;padding-top:10px;border-top:1px solid var(--border)}
.side-foot{border-top:1px solid var(--border);padding:10px;display:flex;flex-direction:column;gap:3px}
.side-foot .side-sub{font-size:13px;color:var(--muted)}
.side-foot .side-sub::before{display:none}

.main{flex:1;margin-left:var(--side-w);min-width:0;display:flex;flex-direction:column}
.topbar{
  position:sticky;top:0;z-index:40;background:color-mix(in srgb,var(--bg) 88%,transparent);
  backdrop-filter:blur(10px);border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:14px;padding:0 32px;height:60px;
}
.crumb{font-size:13px;color:var(--muted);display:flex;align-items:center;gap:8px;min-width:0}
.crumb b{color:var(--text);font-weight:600}
.crumb .sep{color:var(--muted-2)}
.topbar .right{margin-left:auto;display:flex;align-items:center;gap:8px}
.tag-env{
  display:inline-flex;align-items:center;gap:6px;
  font-size:12px;font-weight:600;padding:5px 12px;border-radius:999px;
  border:1px solid var(--border-strong);color:var(--muted);white-space:nowrap;
}
.tag-env::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}
.tag-env.dom{border-color:rgba(192,57,43,.4);color:#c0392b;background:rgba(192,57,43,.08)}
.tag-env.glb{border-color:rgba(37,99,235,.35);color:#2563eb;background:rgba(37,99,235,.08)}
.tag-env.base{border-color:rgba(124,58,237,.35);color:#7c3aed;background:rgba(124,58,237,.08)}
html[data-theme="dark"] .tag-env.dom{color:#f08a7e}
html[data-theme="dark"] .tag-env.glb{color:#8ab4ff}
html[data-theme="dark"] .tag-env.base{color:#c4a6ff}

/* ---------- 页面头部版本 chip ---------- */
.env-chip{
  display:inline-flex;align-items:center;gap:6px;margin-left:8px;
  font-size:11.5px;font-weight:600;padding:3px 10px;border-radius:999px;
  border:1px solid transparent;vertical-align:middle;
}
.env-chip::before{content:"";width:5px;height:5px;border-radius:50%;background:currentColor}
.env-chip.dom{color:#c0392b;background:rgba(192,57,43,.08);border-color:rgba(192,57,43,.22)}
.env-chip.glb{color:#2563eb;background:rgba(37,99,235,.08);border-color:rgba(37,99,235,.22)}
.env-chip.base{color:#7c3aed;background:rgba(124,58,237,.08);border-color:rgba(124,58,237,.22)}
html[data-theme="dark"] .env-chip.dom{color:#f08a7e}
html[data-theme="dark"] .env-chip.glb{color:#8ab4ff}
html[data-theme="dark"] .env-chip.base{color:#c4a6ff}
.icon-btn{
  width:34px;height:34px;border-radius:9px;border:1px solid var(--border);
  background:var(--bg);color:var(--muted);display:grid;place-items:center;cursor:pointer;transition:all .18s;
}
.icon-btn:hover{color:var(--text);border-color:var(--border-strong);background:var(--bg-soft)}

.main-inner{max-width:1180px;width:100%;margin:0 auto;padding:30px 32px 72px}

/* ---------- 页头 ---------- */
.page-head{margin-bottom:24px}
.page-head .eyebrow{
  font-family:var(--mono);font-size:11.5px;color:var(--accent);letter-spacing:.14em;
  text-transform:uppercase;margin-bottom:9px;display:flex;align-items:center;gap:8px;
}
.page-head .eyebrow .bar{width:18px;height:1px;background:var(--accent)}
.page-head h1{font-size:25px;font-weight:700;line-height:1.3;letter-spacing:-.01em}
.page-head p{color:var(--muted);font-size:13.5px;margin-top:7px;max-width:720px}

/* ---------- 卡片 ---------- */
.card{background:var(--bg-soft);border:1px solid var(--border);border-radius:16px;padding:22px;transition:border-color .25s}
.card:hover{border-color:var(--border-strong)}
.card.plain:hover{border-color:var(--border)}
.card-h{display:flex;align-items:center;gap:10px;margin-bottom:16px}
.card-h h3{font-size:15px;font-weight:600}
.card-h .r{margin-left:auto;font-size:12px;color:var(--muted-2);font-family:var(--mono)}
.grid{display:grid;gap:16px}
.grid-2{grid-template-columns:1fr 1fr}
.grid-3{grid-template-columns:repeat(3,1fr)}
.grid-4{grid-template-columns:repeat(4,1fr)}
@media(max-width:1080px){.grid-4{grid-template-columns:repeat(2,1fr)}}
@media(max-width:900px){.grid-3{grid-template-columns:1fr 1fr}}
@media(max-width:760px){.grid-2,.grid-3,.grid-4{grid-template-columns:1fr}}

/* ---------- KPI ---------- */
.kpi{
  border:1px solid var(--border);border-radius:14px;background:var(--bg);
  padding:16px 18px;transition:border-color .2s;
}
.kpi:hover{border-color:var(--border-strong)}
.kpi .k{font-size:12.5px;color:var(--muted);display:flex;align-items:center;gap:7px}
.kpi .v{font-size:26px;font-weight:700;font-family:var(--mono);margin-top:8px;letter-spacing:-.02em}
.kpi .v.ph{color:var(--muted-2)}
.kpi .d{font-size:11.5px;color:var(--muted-2);margin-top:5px;font-family:var(--mono)}

/* ---------- 按钮 ---------- */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  padding:8px 16px;border-radius:9px;font-size:13.5px;font-weight:500;
  border:1px solid var(--border-strong);color:var(--text-2);background:var(--bg);
  transition:all .18s;cursor:pointer;
}
.btn:hover{border-color:var(--muted-2);color:var(--text)}
.btn-primary{background:var(--text);color:var(--bg);border-color:var(--text)}
.btn-primary:hover{opacity:.86;color:var(--bg)}
.btn-sm{padding:5px 11px;font-size:12.5px;border-radius:8px}

/* ---------- 占位 / 空状态 ---------- */
.placeholder{
  border:1px dashed var(--border-strong);border-radius:16px;background:var(--bg-soft);
  padding:44px 28px;text-align:center;
}
.placeholder img{width:180px;max-width:60%;margin-bottom:18px;opacity:.9}
.placeholder h4{font-size:15.5px;font-weight:600;margin-bottom:6px}
.placeholder p{font-size:13px;color:var(--muted);max-width:520px;margin:0 auto;line-height:1.75}
.api-hint{
  display:inline-flex;align-items:center;gap:8px;margin-top:16px;
  font-family:var(--mono);font-size:12px;color:var(--muted);
  background:var(--panel);border:1px solid var(--border);border-radius:8px;padding:6px 12px;
}
.api-hint b{color:var(--accent);font-weight:600}

/* ---------- 模块清单 ---------- */
.mods{display:flex;flex-direction:column;gap:10px}
.mod-row{
  display:flex;align-items:center;gap:14px;padding:13px 16px;
  border:1px solid var(--border);border-radius:12px;background:var(--bg);transition:all .18s;
}
.mod-row:hover{border-color:var(--border-strong);background:var(--bg-soft)}
.mod-ic{
  width:34px;height:34px;border-radius:9px;flex:0 0 34px;display:grid;place-items:center;
  background:var(--panel);color:var(--text-2);border:1px solid var(--border);
}
.mod-row .mi{flex:1;min-width:0}
.mod-row .mi b{font-size:13.5px;font-weight:600;display:block}
.mod-row .mi span{font-size:12px;color:var(--muted-2)}
.mod-row .st{font-family:var(--mono);font-size:11px;color:var(--muted-2)}
.badge{
  display:inline-block;font-family:var(--mono);font-size:11px;border-radius:999px;
  padding:2px 9px;border:1px solid var(--border-strong);color:var(--muted);background:var(--bg);
}
.badge.red{color:var(--accent);border-color:rgba(192,57,43,.35);background:var(--accent-soft)}
.badge.blue{color:#3b82f6;border-color:rgba(59,130,246,.35);background:rgba(59,130,246,.09)}
html[data-theme="dark"] .badge.blue{color:#7aa8f7}
.badge.green{color:var(--ok);border-color:rgba(22,163,74,.35)}

/* ---------- 表格骨架 ---------- */
.tbl-wrap{overflow-x:auto;border:1px solid var(--border);border-radius:13px;background:var(--bg)}
table{width:100%;border-collapse:collapse;font-size:13.5px;min-width:560px}
th{font-weight:600;color:var(--muted);text-align:left;padding:11px 16px;border-bottom:1px solid var(--border);white-space:nowrap;font-size:12.5px}
td{padding:13px 16px;border-bottom:1px solid var(--border);color:var(--muted-2)}
tr:last-child td{border-bottom:none}
.skel{display:inline-block;height:9px;border-radius:99px;background:var(--panel);vertical-align:middle}

/* ---------- 提示条 ---------- */
.notice{
  display:flex;gap:12px;align-items:flex-start;padding:14px 16px;border-radius:12px;
  background:var(--accent-soft);border:1px solid rgba(192,57,43,.22);font-size:13px;color:var(--text-2);
}
.notice svg{flex:0 0 17px;margin-top:2px;color:var(--accent)}
.notice b{color:var(--text)}

/* ---------- 响应式 ---------- */
.scrim{display:none}
#menu-btn{display:none}
@media(max-width:1040px){
  :root{--side-w:200px}
  .main-inner{padding:26px 24px 64px}
  .topbar{padding:0 24px}
}
@media(max-width:820px){
  :root{--side-w:0px}
  .sidebar{width:238px;flex:0 0 238px;transform:translateX(-100%);transition:transform .26s ease}
  body.side-open .sidebar{transform:none;box-shadow:var(--shadow)}
  .main{margin-left:0}
  #menu-btn{display:grid}
  .scrim{
    display:block;position:fixed;inset:0;background:rgba(17,17,19,.45);z-index:45;
    opacity:0;pointer-events:none;transition:opacity .26s;
  }
  body.side-open .scrim{opacity:1;pointer-events:auto}
  .topbar{padding:0 16px}
  .main-inner{padding:22px 16px 60px}
  .page-head h1{font-size:21px}
  .grid-2,.grid-3{grid-template-columns:1fr}
}
@media(max-width:560px){
  .grid-4{grid-template-columns:1fr 1fr}
  .kpi .v{font-size:21px}
  .hero h1{font-size:26px}
}

/* ==========================================================
   以下为功能视图组件样式（dashboard / table / accounts / form /
   wizard / chat / kb / grid）
   ========================================================== */

/* ---------- 页面工具条 ---------- */
.toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.search-box{
  flex:1;min-width:200px;max-width:360px;display:flex;align-items:center;gap:8px;
  border:1px solid var(--border-strong);border-radius:10px;background:var(--bg);
  padding:0 12px;color:var(--muted);height:38px;transition:border-color .2s;
}
.search-box:focus-within{border-color:var(--accent)}
.search-box input{flex:1;border:none;outline:none;background:transparent;font-size:13.5px;color:var(--text);font-family:inherit}
.toolbar select{
  height:38px;padding:0 10px;border:1px solid var(--border-strong);border-radius:10px;
  background:var(--bg);color:var(--text);font-size:13.5px;font-family:inherit;outline:none;
}
.tabs{display:flex;gap:6px;flex-wrap:wrap}
.tab{
  padding:7px 14px;border-radius:999px;font-size:13px;color:var(--muted);
  border:1px solid var(--border);background:var(--bg);cursor:pointer;transition:all .18s;font-family:inherit;
}
.tab:hover{color:var(--text);border-color:var(--border-strong)}
.tab.active{background:var(--text);color:var(--bg);border-color:var(--text);font-weight:500}

/* ---------- KPI 补充 ---------- */
.kpi .d.up{color:var(--ok)}
.kpi .d.down{color:var(--accent)}

/* ---------- 趋势图 / 条形图 ---------- */
.trend-svg{width:100%;height:190px;display:block}
.trend-svg text{font-size:10px;fill:var(--muted-2);font-family:var(--mono)}
.bar-row{display:flex;align-items:center;gap:12px;padding:9px 0}
.bar-row+.bar-row{border-top:1px dashed var(--border)}
.bar-name{width:76px;font-size:13px;color:var(--text-2);flex:0 0 76px}
.bar-track{flex:1;height:9px;border-radius:99px;background:var(--panel);overflow:hidden;display:block}
.bar-track i{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,#c0392b,#e05a4b);transition:width .5s ease}
.bar-val{width:72px;text-align:right;font-size:12px;color:var(--muted);flex:0 0 72px}

/* ---------- 表格补充 ---------- */
.cell-b{font-weight:600;font-size:13.5px;display:block}
.cell-sub{font-size:11.5px;color:var(--muted-2)}
.pager{display:flex;align-items:center;justify-content:space-between;margin-top:12px;flex-wrap:wrap;gap:8px}

/* ---------- 账号卡片 ---------- */
.acc-card{
  border:1px solid var(--border);border-radius:15px;background:var(--bg);padding:16px;
  transition:all .2s;display:flex;flex-direction:column;gap:13px;
}
.acc-card:hover{border-color:var(--border-strong);box-shadow:var(--shadow)}
.acc-card.off{opacity:.78}
.acc-top{display:flex;align-items:center;gap:11px}
.acc-ava{
  width:38px;height:38px;border-radius:11px;flex:0 0 38px;display:grid;place-items:center;
  color:#fff;font-weight:700;font-size:15px;
}
.acc-info{flex:1;min-width:0}
.acc-info b{font-size:13.5px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.acc-info span{font-size:11px;color:var(--muted-2)}
.acc-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:11px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.acc-stats .lbl{display:block;font-size:11px;color:var(--muted-2)}
.acc-stats .val{font-size:13px;font-weight:600;margin-top:2px;display:flex;align-items:center}
.acc-foot{display:flex;align-items:center;justify-content:space-between}

/* ---------- 表单 ---------- */
.form-line{display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px dashed var(--border)}
.form-line:last-of-type{border-bottom:none}
.form-line b{font-size:13.5px;display:block}
.form-line span{font-size:11.5px;color:var(--muted-2)}

/* ---------- 向导 ---------- */
.steps{display:flex;gap:6px;margin-bottom:16px;flex-wrap:wrap}
.step{
  display:flex;align-items:center;gap:8px;padding:8px 15px;border-radius:999px;
  font-size:13px;color:var(--muted);border:1px solid var(--border);background:var(--bg);transition:all .2s;
}
.step .no{
  width:19px;height:19px;border-radius:50%;background:var(--panel);color:var(--muted);
  display:grid;place-items:center;font-size:11px;font-family:var(--mono);
}
.step.active{color:var(--text);border-color:var(--accent);background:var(--accent-soft);font-weight:600}
.step.active .no{background:var(--accent);color:#fff}
.wpanel{animation:pop .22s ease}
.pick-card{
  border:1.5px solid var(--border);border-radius:13px;background:var(--bg);padding:15px;
  cursor:pointer;transition:all .18s;display:flex;flex-direction:column;gap:5px;
}
.pick-card:hover{border-color:var(--border-strong)}
.pick-card.sel{border-color:var(--accent);background:var(--accent-soft);box-shadow:0 0 0 3px var(--accent-soft)}
.pick-card b{font-size:14px}
.pick-card span{font-size:11.5px;color:var(--muted-2)}
.pick-card em{font-style:normal;font-size:12px;color:var(--text-2);background:var(--panel);border-radius:7px;padding:3px 8px;align-self:flex-start}
.wfoot{display:flex;justify-content:space-between;margin-top:16px}
.sum-line{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px dashed var(--border);font-size:13.5px}
.sum-line:last-child{border-bottom:none}
.sum-line span{color:var(--muted)}
.sum-line b{font-weight:600}

/* ---------- 会话 ---------- */
.conv-list{max-height:420px;overflow-y:auto;padding:8px}
.conv{display:flex;align-items:center;gap:11px;padding:11px 12px;border-radius:11px;cursor:pointer;transition:background .15s}
.conv:hover{background:var(--bg-soft)}
.conv.sel{background:var(--accent-soft)}
.conv-mid{flex:1;min-width:0}
.conv-mid b{font-size:13.5px;display:block}
.conv-mid span{font-size:12px;color:var(--muted-2);display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.conv-right{display:flex;flex-direction:column;align-items:flex-end;gap:4px}
.unread{
  min-width:17px;height:17px;border-radius:99px;background:var(--accent);color:#fff;
  font-size:10.5px;display:grid;place-items:center;padding:0 5px;font-family:var(--mono);
}

/* ---------- 知识库 ---------- */
.kb-item{margin-bottom:10px;background:var(--bg)}
.kb-item summary span{margin-left:auto}
.kb-ops{display:flex;gap:8px;margin-top:12px}

/* ---------- 通用卡片（grid 视图） ---------- */
.g-card{
  border:1px solid var(--border);border-radius:15px;background:var(--bg);padding:16px;
  display:flex;flex-direction:column;gap:11px;transition:all .2s;
}
.g-card:hover{border-color:var(--border-strong);box-shadow:var(--shadow)}
.g-top{display:flex;align-items:center;gap:11px}
.g-top>div{flex:1;min-width:0}
.g-top b{font-size:13.5px;display:block}
.g-ava{
  width:38px;height:38px;border-radius:11px;flex:0 0 38px;display:grid;place-items:center;
  color:#fff;font-weight:700;font-size:15px;
}
.g-desc{font-size:12.5px;color:var(--muted);line-height:1.65;flex:1}
.g-prog{display:flex;align-items:center;gap:10px}
.g-prog .bar-track{flex:1}
.g-foot{display:flex;align-items:center;justify-content:space-between;border-top:1px dashed var(--border);padding-top:11px}
.g-foot>span:last-child{display:flex;gap:8px}

/* ---------- toast / loading / modal ---------- */
#agent-toast{
  position:fixed;left:50%;top:24px;transform:translate(-50%,-70px);z-index:999;
  background:var(--text);color:var(--bg);padding:10px 22px;border-radius:999px;
  font-size:13.5px;box-shadow:var(--shadow);transition:transform .3s ease;max-width:82vw;
}
#agent-toast.show{transform:translate(-50%,0)}
.loading{
  text-align:center;padding:80px 0;color:var(--muted-2);font-size:13.5px;font-family:var(--mono);
}
.modal-body{font-size:14px}
.modal-body .field:last-child{margin-bottom:0}

/* ---------- 主题适配组件 ---------- */
html[data-theme="dark"] .bar-track{background:#2a2a2e}
html[data-theme="dark"] .acc-card,html[data-theme="dark"] .g-card{background:var(--bg-soft)}

/* ==========================================================
   v0.4 补齐：缺失组件样式（表单 / 开关 / 弹窗 / 私信 / 工具类）
   ========================================================== */

/* ---------- 工具类 ---------- */
.mono{font-family:var(--mono);font-variant-numeric:tabular-nums}
.small{font-size:11.5px}
.muted{color:var(--muted)}
.divider{height:1px;background:var(--border);margin:16px 0}

/* ---------- 表单控件 ---------- */
input,select,textarea{
  font-family:inherit;font-size:13.5px;color:var(--text);width:100%;
  background:var(--bg);border:1px solid var(--border-strong);border-radius:10px;
  padding:9px 12px;outline:none;transition:border-color .18s,box-shadow .18s;
}
input:focus,select:focus,textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
input[type="checkbox"],input[type="radio"]{width:auto;accent-color:var(--accent)}
textarea{min-height:88px;resize:vertical;line-height:1.6}
.field{display:flex;flex-direction:column;gap:6px;margin-bottom:14px}
.field label{font-size:12.5px;font-weight:600;color:var(--text-2)}
.field label em{color:var(--accent);font-style:normal;margin-left:2px}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:0 16px}

/* 单选 pill 组（登录方式 / 目标名单） */
.pay-way{display:flex;gap:8px;flex-wrap:wrap}
.pay-way label{
  padding:8px 16px;border:1.5px solid var(--border);border-radius:10px;
  font-size:13px;color:var(--text-2);cursor:pointer;transition:all .18s;
  background:var(--bg);user-select:none;
}
.pay-way label:hover{border-color:var(--border-strong);color:var(--text)}
.pay-way label.sel{border-color:var(--accent);color:var(--accent);background:var(--accent-soft);font-weight:600}

/* iOS 开关 */
.switch{position:relative;display:inline-block;width:38px;height:22px;flex:0 0 38px;cursor:pointer}
.switch input{position:absolute;opacity:0;width:0;height:0}
.switch i{position:absolute;inset:0;border-radius:999px;background:var(--border-strong);transition:.22s}
.switch i::before{
  content:"";position:absolute;top:2.5px;left:2.5px;width:17px;height:17px;border-radius:50%;
  background:#fff;transition:.22s;box-shadow:0 1px 3px rgba(0,0,0,.25);
}
.switch input:checked+i{background:var(--ok)}
.switch input:checked+i::before{transform:translateX(16px)}

/* ---------- 弹窗 ---------- */
.mask{
  position:fixed;inset:0;z-index:200;background:rgba(17,17,19,.45);
  display:none;align-items:center;justify-content:center;padding:24px;
  backdrop-filter:blur(2px);
}
.mask.show{display:flex;animation:fadeIn .18s ease}
.modal{
  background:var(--bg);border:1px solid var(--border);border-radius:16px;
  width:min(460px,92vw);max-height:82vh;display:flex;flex-direction:column;
  box-shadow:var(--shadow);animation:pop .2s ease;overflow:hidden;
}
.modal h3{margin:0;padding:18px 22px 4px;font-size:16px}
.modal-body{padding:12px 22px;overflow-y:auto;font-size:14px;line-height:1.7}
.modal-foot{display:flex;justify-content:flex-end;gap:10px;padding:14px 22px 18px;border-top:1px solid var(--border)}
.modal-foot .btn{min-width:88px}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}

/* ---------- 私信对话 ---------- */
.chat-box{
  flex:1;min-height:340px;max-height:460px;overflow-y:auto;padding:18px;
  display:flex;flex-direction:column;gap:12px;background:var(--bg-soft);
}
.bubble{max-width:72%;padding:10px 14px;border-radius:14px;font-size:13.5px;line-height:1.6;animation:pop .2s ease}
.bubble.bot{align-self:flex-start;background:var(--bg);border:1px solid var(--border);border-bottom-left-radius:4px}
.bubble.me{align-self:flex-end;background:var(--text);color:var(--bg);border-bottom-right-radius:4px}
.bubble .t{display:block;font-size:10.5px;opacity:.55;margin-top:4px;font-family:var(--mono)}
.chat-input{display:flex;gap:10px;padding:14px 18px;border-top:1px solid var(--border);background:var(--bg)}
.chat-input input{flex:1}

/* ---------- 状态点 / 知识库答案 / 向导 ---------- */
.dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;vertical-align:1px}
.dot.on{background:var(--ok);box-shadow:0 0 0 3px color-mix(in srgb,var(--ok) 18%,transparent)}
.dot.off{background:var(--muted-2);box-shadow:0 0 0 3px rgba(0,0,0,.05)}
.ans{font-size:13px;color:var(--text-2);line-height:1.75;margin-top:6px}
.wizard{max-width:1020px}

/* ---------- 深色适配 ---------- */
html[data-theme="dark"] .switch i::before{background:#e4e4e7}
html[data-theme="dark"] .bubble.me{background:var(--accent);color:#fff}
html[data-theme="dark"] .mask{background:rgba(0,0,0,.6)}

/* ---------- 侧栏分组折叠 ---------- */
.g-head{cursor:pointer;user-select:none;transition:color .15s}
.g-head:hover{color:var(--text)}
.g-head .chev{
  flex:0 0 auto;width:14px;height:14px;transition:transform .2s ease;opacity:.7;
}
.side-group.collapsed .side-sub{display:none}
.side-group.collapsed .chev{transform:rotate(-90deg)}
.side-group.flat{padding-bottom:2px}
