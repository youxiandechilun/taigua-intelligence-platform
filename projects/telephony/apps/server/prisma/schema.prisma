// Durable quote consumption and provider-purchase state. A completed row is
// intentionally retained after the PhoneNumber is released so the signed quote
// nonce can never purchase or debit a second time.
model PhoneNumberPurchase {
  phoneNumberPurchaseId     String                    @id @default(uuid())
  quoteNonce                String                    @unique
  organizationId            String
  organization              Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedByUserId         String?
  phoneNumber               String
  provider                  TelephonyProvider
  providerMonthlyCostMicros BigInt
  rentalPriceMicros         BigInt
  billingCountryIso         String
  billingNumberType         String
  rateCatalogVersion        String
  quoteExpiresAt            DateTime
  status                    PhoneNumberPurchaseStatus @default(PENDING)
  billingReservationId      String?                   @unique
  providerResourceId        String?
  providerOrderId           String?
  providerFriendlyName      String?
  persistedPhoneNumberId    String                    @unique
  providerAttemptedAt       DateTime?
  providerPurchasedAt       DateTime?
  phonePersistedAt          DateTime?
  completedAt               DateTime?
  failedAt                  DateTime?
  processingToken           String?
  processingExpiresAt       DateTime?
  attemptCount              Int                       @default(0)
  lastErrorCode             String?
  lastErrorMessage          String?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  @@index([organizationId, createdAt])
  @@index([phoneNumber, status])
  @@index([status, processingExpiresAt])
  @@index([providerResourceId])
  @@index([providerOrderId])
}

model Agent {
