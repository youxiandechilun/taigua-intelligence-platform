model CallLog {
  readStates CallLogReadState[]
  crmLinks CrmCallLink[]
  callId         String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String?
  agent          Agent?       @relation(fields: [agentId], references: [agentId], onDelete: SetNull)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Call Data
  startTime          DateTime?
  endTime            DateTime?
  durationSeconds    Int?
  status             CallStatus
  audioRecordingPath String?
  callerId           String?
  metadata           Json?
  sessionId          String?
  direction          String?
  dataExtracted      Json?            @default("[]")
  dataEvaluation     Json?            @default("[]")
  // Future-use fields
  callCostCents      Int?
  transcripts        CallTranscript[]
  // Soft-deleted rows retain only the minimum operational tombstone.
  deleted            Boolean          @default(false)
  outbound           OutboundCall?

  @@index([organizationId])
  @@index([organizationId, startTime])
  @@index([organizationId, endTime])
  @@unique([organizationId, callId])
  @@index([agentId])
  @@index([userId])
}

