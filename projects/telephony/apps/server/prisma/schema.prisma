model AliyunEngineCall {
 attemptId String @id
 attempt SipAttempt @relation(fields:[attemptId],references:[id],onDelete:Cascade)
 workspaceId String
 workspace Organization @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
 outId String @unique
 remoteId String? @unique
 releaseId String
 release AgentRelease @relation(fields:[releaseId],references:[id],onDelete:NoAction,onUpdate:NoAction)
 lastSequence Int @default(0)
 recordingUrl String @default("")
 createdAt DateTime @default(now()) @db.Timestamptz
}
model AliyunEngineReceipt {
 id String @id
 payload Json
 processedAt DateTime? @db.Timestamptz
 attempts Int @default(0)
 nextAt DateTime @default(now()) @db.Timestamptz
 createdAt DateTime @default(now()) @db.Timestamptz
 // The migration adds a partial index for unprocessed receipts only.
}

model WorkspaceAnnouncement {
  id String @id @default(uuid())
  workspaceId String
  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  text String
  color String @default("#b83240")
  speed String @default("normal")
  fontSize Int @default(14)
  startsAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))
  endsAt DateTime?
  stoppedAt DateTime?
  deletedAt DateTime?
  createdById String?
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  requestId String
  createdAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))
  updatedAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @updatedAt

  @@unique([workspaceId, requestId])
  @@index([workspaceId, deletedAt, stoppedAt, startsAt, endsAt], map: "WorkspaceAnnouncement_workspace_live")
}
