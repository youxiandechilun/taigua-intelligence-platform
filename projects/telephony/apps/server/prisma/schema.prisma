// 中文导读：Prisma 数据模型：定义表、字段、关系和索引；生成客户端前需配置数据库连接。
generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum sourceType {
  PDF
  TXT
  CSV
  DOCX
  XLSX
  XLS
  URL
}

enum CallStatus {
  NOT_ANSWERED
  SCHEDULED
  PROCESSED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum CampaignStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
  PROCESSED
  FAILED
}

enum kbStatus {
  PROCESSING
  ACTIVE
  ERROR
}

enum OutboundCallMode {
  quick
  campaign
}

enum PlanId {
  free
  payg
  starter
  growth
  scale
  enterprise
  admin
}

enum TelephonyProvider {
  TWILIO @map("twilio")
  TELNYX @map("telnyx")
}

enum McpConnectionStatus {
  PENDING
  CONNECTED
  AUTH_REQUIRED
  INPUT_REQUIRED
  ERROR
  DISCONNECTED
}

enum McpCatalogSource {
  SMITHERY
  CUSTOM
}

enum AgentWidgetSessionStatus {
  CREATED
  ACTIVE
  ENDED
  EXPIRED
  FAILED
}

enum BillingTransactionType {
  PROMOTIONAL_GRANT
  TOP_UP
  CALL_RESERVATION
  CALL_SETTLEMENT
  RESERVATION_RELEASE
  NUMBER_PURCHASE
  NUMBER_RENEWAL
  REFUND
  DISPUTE
  ADJUSTMENT
  DEBT_INCURRED
  DEBT_REPAYMENT
}

enum BillingReservationPurpose {
  CALL_USAGE
  PHONE_NUMBER_PURCHASE
  PHONE_NUMBER_RENEWAL
}

enum BillingReservationStatus {
  ACTIVE
  SETTLED
  RELEASED
}

enum TopUpStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

enum TopUpKind {
  MANUAL
  AUTOMATIC
}

enum TopUpTaxMode {
  DISABLED
  STRIPE_TAX
}

enum CallBillingSessionStatus {
  AUTHORIZED
  ACTIVE
  ENDED
  RECONCILING
  SETTLED
  DEBT
}

enum CallBillingMode {
  WALLET
  LEGACY_SUBSCRIPTION
}

enum StripeWebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum TelephonyCostReportStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
  EXPIRED
}

enum PhoneNumberBillingStatus {
  ACTIVE
  SUSPENDED
  RELEASE_PENDING
  RELEASING
  RELEASED
}

enum PhoneNumberPurchaseStatus {
  PENDING
  RESERVED
  PROVIDER_PENDING
  PROVIDER_PURCHASED
  NUMBER_PERSISTED
  SUCCEEDED
  FAILED
  REQUIRES_ATTENTION
}

// ─── Better Auth Core Tables ─────────────────────────────────────────────────

model Department {
  id        String   @id
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model TaiguaMerchant {
  organizationId String @id
  merchantId String
  agentSlug String
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([merchantId, agentSlug])
}

model TaiguaSession {
  sessionTokenHash String @id
  organizationId String
  platformToken String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([organizationId])
  @@index([expiresAt])
}

model TaiguaCallCharge {
  attemptId String @id
  organizationId String
  merchantId String
  holdId String @unique
  reservedQuantity Int
  actualQuantity Int?
  status String @default("RESERVED")
  lastError String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, updatedAt])
}

model User {
  announcements WorkspaceAnnouncement[]
  deletedAt DateTime?
  automationRules AutomationRule[]
  automationRuns AutomationRun[]
  automationTodos AutomationTodo[]
  id               String       @id
  name             String
  email            String
  emailVerified    Boolean      @default(false)
  image            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  role             String?
  banned           Boolean?     @default(false)
  banReason        String?
  banExpires       DateTime?
  stripeCustomerId String?
  departmentId     String?
  department       Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sessions         Session[]
  accounts         Account[]
  members          Member[]
  invitations      Invitation[]

  // App resource reverse relations
  phoneNumbers     PhoneNumber[]
  agents           Agent[]
  knowledgeSources KnowledgeSource[]
  callLogs         CallLog[]
  callReadStates   CallLogReadState[]
  outboundCalls    OutboundCall[]
  campaigns        Campaign[]
  tools            Tool[]
  mcpConnections   McpConnection[]
  secrets          Secret[]
  auditLogs        AuditLog[]
  promotionalGrant PromotionalGrant?

  @@unique([email])
  sipTasks SipTask[]
  callbackEmployees CallbackEmployee[]
  sipSeats SipSeat[]
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy       String?
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ─── Better Auth Plugin Tables ───────────────────────────────────────────────

model Apikey {
  id                  String    @id
  configId            String    @default("default")
  name                String?
  start               String?
  referenceId         String
  prefix              String?
  key                 String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(false)
  rateLimitTimeWindow Int?      @default(60000)
  rateLimitMax        Int?      @default(300)
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
}

// ─── Organization & Team ─────────────────────────────────────────────────────

model Organization {
  announcements WorkspaceAnnouncement[]
  agentReleases AgentRelease[]
  agentDeployments AgentDeployment[]
  agentReleaseMigration AgentReleaseMigration?
  callPolicy WorkspaceCallPolicy?
  callDispatchTurns CallDispatchTurn[]
  aliyunEngineConnection AliyunEngineConnection?
  aliyunEngineCalls AliyunEngineCall[]
  agentLearningRecordings AgentLearningRecording[]
  agentRehearsals AgentRehearsal[]
  crmCompanies CrmCompany[]
  crmContacts CrmContact[]
  crmLeads CrmLead[]
  crmTasks CrmTask[]
  crmActivities CrmActivity[]
  crmCallLinks CrmCallLink[]
  automationRules AutomationRule[]
  automationRuns AutomationRun[]
  automationTodos AutomationTodo[]
  id                             String                          @id
  name                           String
  slug                           String
  logo                           String?
  createdAt                      DateTime
  metadata                       String?
  deletedAt                      DateTime?
  deletedById                    String?
  recycleState                   Json?
  stripeCustomerId               String?
  companyRolesInitialized        Boolean @default(false)
  companyRoles                   CompanyRole[]
  companyDepartments             CompanyDepartment[]
  members                        Member[]
  invitations                    Invitation[]
  accessKey                      String?
  plan                           PlanId                          @default(free)
  agents                         Agent[]
  agentWidgets                   AgentWidget[]
  workspaceKnowledge             WorkspaceKnowledge[]
  knowledgeSources               KnowledgeSource[]
  phoneNumbers                   PhoneNumber[]
  tools                          Tool[]
  mcpConnections                 McpConnection[]
  mcpCatalogItems                McpServerCatalogItem[]
  agentMcpConnections            AgentMcpConnection[]
  mcpToolExecutionLogs           McpToolExecutionLog[]
  secrets                        Secret[]
  callLogs                       CallLog[]
  outboundCalls                  OutboundCall[]
  campaigns                      Campaign[]
  campaignPersonalizationSchemas CampaignPersonalizationSchema[]
  campaignRecipientSnapshots     CampaignRecipientSnapshot[]
  campaignExperiments            CampaignExperiment[]
  campaignExperimentAssignments  CampaignExperimentAssignment[]
  campaignGoals                  CampaignGoal[]
  campaignConversionEvents       CampaignConversionEvent[]
  campaignAttributionResults     CampaignAttributionResult[]
  campaignReportSnapshots        CampaignReportSnapshot[]
  organizationroles              OrganizationRole[]
  auditLogs                      AuditLog[]
  billingAccount                 BillingAccount?
  billingTransactions            BillingTransaction[]
  billingReservations            BillingReservation[]
  promotionalGrant               PromotionalGrant?
  topUps                         TopUp[]
  callBillingSessions            CallBillingSession[]
  stripeWebhookEvents            StripeWebhookEvent[]
  phoneNumberPurchases           PhoneNumberPurchase[]
  aliyunConnection               AliyunConnection?
  wecomConnection                WecomConnection?
  wecomContactWays               WecomContactWay[]
  wecomMembers                   WecomMember[]
  wecomExternalContacts          WecomExternalContact[]
  wecomEvents                    WecomEvent[]
  wecomNotificationPolicy        WecomNotificationPolicy?
  wecomNotificationDeliveries    WecomNotificationDelivery[]
  aliyunTasks                    AliyunTask[]
  sipConnection                  SipConnection?
  sipRegionalLines               SipRegionalLine[]
  voiceLibrary                   WorkspaceVoice[]
  sipTasks                       SipTask[]
  sipProfiles                    SipAgentProfile[]
  sipSeats                       SipSeat[]
  modelSettings                  WorkspaceModelSettings?

  @@unique([slug])
  @@index([deletedAt])
  @@index([stripeCustomerId])
  callbackConnection CallbackConnection?
  callbackEmployees CallbackEmployee[]
}

// Cloud-managed voice uses its own task lifecycle; it does not create SIP rooms.
model AliyunConnection {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  settings       Json
  credentials    String?
  updatedAt      DateTime     @updatedAt
}

model AliyunTask {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String
  provider       String       @default("outboundbot")
  cloudAgentId   String?
  cloudBranchId  String?
  cloudVersionId String?
  name           String
  status         String       @default("DRAFT")
  regionId       String
  instanceId     String
  scriptId       String
  callerNumber   String
  remoteId       String?
  recipients     Json
  executionPolicy Json        @default("{}")
  results        Json         @default("[]")
  startTime      DateTime
  endTime        DateTime
  errorMessage   String?
  syncedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
}

model AliyunReceipt {
  id             String   @id
  kind           String
  payload        Json
  receivedAt     DateTime @default(now())
  processedAt    DateTime?
  attempts       Int      @default(0)
  errorCode      String?

  @@index([processedAt, receivedAt])
}

model OrganizationRole {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String
  permission     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt

  @@index([organizationId])
  @@index([role])
}

model Member {
  voicePreferences EmployeeVoicePreference[]
  wecomBinding WecomMember?
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  enabled        Boolean      @default(true)
  deletedAt      DateTime?
  companyRoleId String?
  companyRole CompanyRole? @relation(fields: [organizationId, companyRoleId], references: [workspaceId, id], onDelete: Restrict)
  scopeDepartmentIds String[] @default([])
  companyDepartmentId String?
  companyDepartment CompanyDepartment? @relation(fields: [companyDepartmentId], references: [id], onDelete: SetNull)
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([organizationId, deletedAt])
  @@index([organizationId])
  @@index([userId])
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([inviterId])
}

// ─── Billing (Better Auth Stripe Plugin) ─────────────────────────────────────

model Subscription {
  id                   String    @id
  plan                 String
  referenceId          String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String?   @default("incomplete")
  periodStart          DateTime?
  periodEnd            DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean?  @default(false)
  cancelAt             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  seats                Int?
  billingInterval      String?
  stripeScheduleId     String?

  @@index([referenceId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status])
}

// ─── Prepaid Wallet Billing ─────────────────────────────────────────────────

model BillingAccount {
  billingAccountId            String               @id @default(uuid())
  organizationId              String               @unique
  organization                Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currency                    String               @default("USD")
  paidBalanceMicros           BigInt               @default(0)
  promotionalBalanceMicros    BigInt               @default(0)
  reservedPaidMicros          BigInt               @default(0)
  reservedPromotionalMicros   BigInt               @default(0)
  debtMicros                  BigInt               @default(0)
  autoRechargeEnabled         Boolean              @default(false)
  autoRechargeThresholdMicros BigInt               @default(5000000)
  autoRechargeAmountMicros    BigInt               @default(20000000)
  stripePaymentMethodId       String?
  paymentMethodRequestVersion Int                  @default(0)
  paymentMethodAppliedVersion Int                  @default(0)
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  transactions                BillingTransaction[]
  reservations                BillingReservation[]
  promotionalGrant            PromotionalGrant?
  topUps                      TopUp[]
  callBillingSessions         CallBillingSession[]

  @@index([autoRechargeEnabled])
}

// This is an append-only ledger. Application code never updates or deletes
// rows; mutable reservation/account projections are derived alongside inserts
// in the same serializable database transaction.
model BillingTransaction {
  billingTransactionId           String                 @id @default(uuid())
  billingAccountId               String
  billingAccount                 BillingAccount         @relation(fields: [billingAccountId], references: [billingAccountId], onDelete: Cascade)
  organizationId                 String
  organization                   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type                           BillingTransactionType
  idempotencyKey                 String
  grossAmountMicros              BigInt                 @default(0)
  paidBalanceDeltaMicros         BigInt                 @default(0)
  promotionalBalanceDeltaMicros  BigInt                 @default(0)
  reservedPaidDeltaMicros        BigInt                 @default(0)
  reservedPromotionalDeltaMicros BigInt                 @default(0)
  debtDeltaMicros                BigInt                 @default(0)
  paidBalanceAfterMicros         BigInt
  promotionalBalanceAfterMicros  BigInt
  reservedPaidAfterMicros        BigInt
  reservedPromotionalAfterMicros BigInt
  debtAfterMicros                BigInt
  referenceType                  String?
  referenceId                    String?
  description                    String?
  metadata                       Json?
  createdAt                      DateTime               @default(now())
  promotionalGrant               PromotionalGrant?

  @@unique([billingAccountId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([referenceType, referenceId])
  @@index([type, createdAt])
}

model BillingReservation {
  billingReservationId    String                    @id @default(uuid())
  billingAccountId        String
  billingAccount          BillingAccount            @relation(fields: [billingAccountId], references: [billingAccountId], onDelete: Cascade)
  organizationId          String
  organization            Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purpose                 BillingReservationPurpose
  status                  BillingReservationStatus  @default(ACTIVE)
  idempotencyKey          String
  amountMicros            BigInt
  paidAmountMicros        BigInt                    @default(0)
  promotionalAmountMicros BigInt                    @default(0)
  settledAmountMicros     BigInt                    @default(0)
  debtIncurredMicros      BigInt                    @default(0)
  referenceType           String?
  referenceId             String?
  expiresAt               DateTime?
  settledAt               DateTime?
  releasedAt              DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@unique([billingAccountId, idempotencyKey])
  @@index([organizationId, status])
  @@index([referenceType, referenceId])
  @@index([expiresAt])
}

model PromotionalGrant {
  promotionalGrantId   String              @id @default(uuid())
  userId               String?             @unique
  user                 User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  // HMAC of normalized verified email. It survives user deletion so deleting
  // and recreating an account cannot claim the signup promotion repeatedly.
  identityHash         String              @unique
  organizationId       String?             @unique
  organization         Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  billingAccountId     String?             @unique
  billingAccount       BillingAccount?     @relation(fields: [billingAccountId], references: [billingAccountId], onDelete: SetNull)
  amountMicros         BigInt
  billingTransactionId String?             @unique
  billingTransaction   BillingTransaction? @relation(fields: [billingTransactionId], references: [billingTransactionId], onDelete: SetNull)
  reason               String              @default("signup")
  grantedAt            DateTime            @default(now())

  // The @unique fields above already provide indexes for both lookups.
}

model TopUp {
  topUpId                        String         @id @default(uuid())
  billingAccountId               String
  billingAccount                 BillingAccount @relation(fields: [billingAccountId], references: [billingAccountId], onDelete: Cascade)
  organizationId                 String
  organization                   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedByUserId              String?
  idempotencyKey                 String
  kind                           TopUpKind      @default(MANUAL)
  automaticContextKey            String?
  processingToken                String?
  processingExpiresAt            DateTime?
  reconciliationNextAt           DateTime?
  reconciliationAttempts         Int            @default(0)
  stripeCheckoutSessionId        String?        @unique
  stripePaymentIntentId          String?        @unique
  stripeTaxCalculationId         String?        @unique
  taxMode                        TopUpTaxMode   @default(DISABLED)
  stripeTaxCode                  String?
  amountMicros                   BigInt
  taxMicros                      BigInt         @default(0)
  creditedMicros                 BigInt         @default(0)
  refundedMicros                 BigInt         @default(0)
  disputedMicros                 BigInt         @default(0)
  refundTargetProviderCents      BigInt         @default(0)
  disputeTargetProviderCents     BigInt         @default(0)
  stripeDisputeId                String?
  disputeState                   String         @default("NONE")
  financialProcessingToken       String?
  financialProcessingExpiresAt   DateTime?
  financialReconciliationPending Boolean        @default(false)
  status                         TopUpStatus    @default(PENDING)
  failureCode                    String?
  failureMessage                 String?
  createdAt                      DateTime       @default(now())
  updatedAt                      DateTime       @updatedAt
  completedAt                    DateTime?

  @@unique([billingAccountId, idempotencyKey])
  @@unique([billingAccountId, automaticContextKey])
  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@index([kind, status, reconciliationNextAt])
  @@index([financialReconciliationPending, financialProcessingExpiresAt], map: "TopUp_financial_reconciliation_idx")
}

model CallBillingSession {
  callBillingSessionId     String                   @id @default(uuid())
  callId                   String                   @unique
  billingAccountId         String
  billingAccount           BillingAccount           @relation(fields: [billingAccountId], references: [billingAccountId], onDelete: Cascade)
  organizationId           String
  organization             Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status                   CallBillingSessionStatus @default(AUTHORIZED)
  billingMode              CallBillingMode          @default(WALLET)
  admissionGeneration      Int                      @default(1)
  rateCatalogVersion       String
  rateSnapshot             Json
  lastModelUsage           Json?
  activeReservationId      String?
  sessionId                String?                  @unique
  roomName                 String?
  agentId                  String?
  userId                   String?
  lastUsageSequence        Int                      @default(0)
  processingUsageSequence  Int?
  processingUsageStartedAt DateTime?
  connectedSeconds         Int                      @default(0)
  connectedMilliseconds    BigInt                   @default(0)
  aiCostMicros             BigInt                   @default(0)
  platformCostMicros       BigInt                   @default(0)
  livekitEstimatedMicros   BigInt                   @default(0)
  telephonyEstimatedMicros BigInt                   @default(0)
  telephonyFinalMicros     BigInt?
  unreportedTailMicros     BigInt                   @default(0)
  totalSettledMicros       BigInt                   @default(0)
  debtIncurredMicros       BigInt                   @default(0)
  telephonyProvider        TelephonyProvider?
  providerCallId           String?
  providerBillableSeconds  Int?
  reconciliationAttempts   Int                      @default(0)
  reconciliationClaimedAt  DateTime?
  reconciliationNextAt     DateTime?
  reconciliationLastError  String?
  startedAt                DateTime?
  endedAt                  DateTime?
  reconciledAt             DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@unique([telephonyProvider, providerCallId])
  @@index([organizationId, status])
  @@index([roomName])
  @@index([agentId])
  @@index([userId])
  @@index([status, endedAt])
  @@index([status, reconciliationNextAt])
}

// Telnyx SIP trunk charges are published asynchronously as CDR CSV reports.
// Persisting report requests makes provider-final reconciliation restart-safe
// and prevents duplicate paid report generation after a worker crash.
model TelephonyCostReport {
  telephonyCostReportId String                    @id @default(uuid())
  provider              TelephonyProvider
  periodStart           DateTime
  periodEnd             DateTime
  externalReportId      String?                   @unique
  status                TelephonyCostReportStatus @default(PENDING)
  reportUrl             String?
  attempts              Int                       @default(0)
  nextAttemptAt         DateTime?
  processingToken       String?
  processingExpiresAt   DateTime?
  lastError             String?
  processedAt           DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@unique([provider, periodStart, periodEnd])
  @@index([provider, status, nextAttemptAt])
  @@index([processingExpiresAt])
}

model StripeWebhookEvent {
  stripeEventId  String                   @id
  organizationId String?
  organization   Organization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  type           String
  status         StripeWebhookEventStatus @default(RECEIVED)
  livemode       Boolean
  payload        Json
  attempts       Int                      @default(0)
  lastError      String?
  receivedAt     DateTime                 @default(now())
  processedAt    DateTime?
  updatedAt      DateTime                 @updatedAt

  @@index([organizationId, receivedAt])
  @@index([status, receivedAt])
  @@index([type, receivedAt])
}

// ─── App Resource Models ─────────────────────────────────────────────────────

model PhoneNumber {
  phId                      String                   @id @default(uuid())
  number                    String                   @unique
  organizationId            String
  organization              Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId                    String?
  user                      User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  agentId                   String?
  agent                     Agent?                   @relation(fields: [agentId], references: [agentId], onDelete: SetNull)
  sid                       String
  friendlyName              String
  provider                  TelephonyProvider        @default(TWILIO)
  billingStatus             PhoneNumberBillingStatus @default(ACTIVE)
  providerMonthlyCostMicros BigInt?
  rentalPriceMicros         BigInt?
  nextBillingAt             DateTime?
  lastBilledAt              DateTime?
  billingSuspendedAt        DateTime?
  scheduledReleaseAt        DateTime?
  billingOperationToken     String?
  billingOperationExpiresAt DateTime?
  billingReleaseClaimedAt   DateTime?
  billingFailureCount       Int                      @default(0)
  lastBillingAttemptAt      DateTime?
  billingNoticeSentAt       DateTime?
  billingSuspendedAgentId   String?
  billingCountryIso         String?
